# Copy to infra/prod/.env and fill in. Generate secrets with: openssl rand -hex 24
DOMAIN=iuriguerreiro.dev
TUNNEL_TOKEN=                 # Cloudflare Zero Trust > Networks > Tunnels
TAILSCALE_IP=100.64.0.1       # this box's Tailscale IP (tailscale ip -4)
POSTGRES_PASSWORD=
ZITADEL_DB_PASSWORD=
ZITADEL_MASTERKEY=            # exactly 32 characters: openssl rand -hex 16
NATS_PASSWORD=
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=
OTEL_EXPORTER_OTLP_ENDPOINT=  # e.g. http://<signoz-host>:4317, empty = off
