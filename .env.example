# Copy to .env (git-ignored). Everything here is optional for local dev.

# development (default) or production
APP_ENV=development
# API_ADDR=127.0.0.1:7100
# DATABASE_URL=postgres://app:app@127.0.0.1:55432/app
# ZITADEL_URL=http://localhost:7102
# ZITADEL_PAT_FILE=infra/.secrets/api.pat
# API_SIGNING_KEY_FILE=infra/.secrets/api_signing_key

# Logs: RUST_LOG level, LOG_FORMAT=json for structured stdout
# RUST_LOG=info
# LOG_FORMAT=json

# Observability: send logs, traces and metrics to SigNoz (OTLP/gRPC).
# Leave unset to only log to stdout. See docs/architecture/observability.md
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
