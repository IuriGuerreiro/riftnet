{
  "name": "adept",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "gen": "pnpm --filter client gen",
    "dev": "pnpm --filter client dev",
    "desktop": "pnpm --filter client tauri dev",
    "mock": "pnpm --filter mock start",
    "lint": "eslint .",
    "build": "pnpm -r build",
    "lint:comments": "node tools/lint/check-rust-comments.mjs",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "proto:lint": "pnpm --filter client proto:lint",
    "audit": "pnpm audit --prod"
  },
  "packageManager": "pnpm@11.18.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-dom": "^5.30.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-react-x": "^5.30.2",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unicorn": "^79.0.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.72.2"
  },
  "type": "module"
}
